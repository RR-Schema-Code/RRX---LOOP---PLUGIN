<Page x:Class="RRX.Xml.ProjectTree.PageProjectTree"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dd="clr-namespace:RRX.DragDrop;assembly=RRX.DragDrop"
      xmlns:local="clr-namespace:RRX.Xml.ProjectTree"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1300"
      Title="ProjectTree">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="TreeStatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <EventSetter Event="Collapsed" Handler="TreeItem_Collapsed" />
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type local:RrxProjectTreeItem}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Background="Transparent" Height="22" Margin="1">
                <Path Data="{Binding IconData}" Fill="{Binding IconBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DisplayName}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Kind}" Style="{StaticResource TreeStatusText}" />
                <TextBlock Text="{Binding Uid}" Style="{StaticResource TreeStatusText}" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type local:TemplateTreeItem}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Background="Transparent" Height="22" Margin="1">
                <Path Data="{Binding IconData}" Fill="{Binding IconBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DisplayName}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource TreeStatusText}" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type local:ItemProjectTreeDefault}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" FontSize="12" />
        </HierarchicalDataTemplate>
    </Page.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock x:Name="VersionText" Foreground="#444444" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="RRX XML nach ASP - Systemfolder - Component" Foreground="#555555" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="0.8*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="XML" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="RrxStatus" Grid.Column="1" Foreground="#666666" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="Laden" Padding="10,4" Click="LoadRrx_Click" />
                        </StackPanel>
                    </Grid>

                    <TreeView x:Name="Templates"
                              Grid.Row="1"
                              VerticalAlignment="Stretch"
                              dd:DragDrop.DropTargetAdornerBrush="Red"
                              dd:DragDrop.UseDefaultDragAdorner="False"
                              dd:DragDrop.UseVisualSourceItemSizeForDragAdorner="False"
                              dd:DragDrop.IsDragSource="False"
                              dd:DragDrop.IsDropTarget="False"
                              dd:DragDrop.DropScrollingMode="VerticalOnly"
                              Loaded="Tree_Loaded"
                              RequestBringIntoView="Tree_RequestBringIntoView" />
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Vorlagen" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="TemplateStatus" Grid.Column="1" Foreground="#666666" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <WrapPanel Grid.Column="2" HorizontalAlignment="Right" Margin="8,0,0,0">
                            <Button Content="Laden" Padding="10,4" Margin="0,0,6,4" Click="LoadTemplateTree_Click" />
                            <Button Content="Speichern" Padding="10,4" Margin="0,0,6,4" Click="SaveTemplateTree_Click" />
                            <Button Content="Gruppe" Padding="10,4" Margin="0,0,6,4" Click="AddTemplateGroup_Click" />
                            <Button Content="Vorlage" Padding="10,4" Margin="0,0,6,4" Click="AddTemplate_Click" />
                            <Button Content="Seitentemplate" Padding="10,4" Margin="0,0,6,4" Click="AddPageTemplate_Click" />
                            <Button Content="Entfernen" Padding="10,4" Margin="0,0,0,4" Click="RemoveTemplateItem_Click" />
                        </WrapPanel>
                    </Grid>

                    <TreeView x:Name="TemplateTree"
                              Grid.Row="1"
                              VerticalAlignment="Stretch"
                              ItemsSource="{Binding TemplateItems}"
                              SelectedItemChanged="TemplateTree_SelectedItemChanged"
                              dd:DragDrop.DropTargetAdornerBrush="Red"
                              dd:DragDrop.UseDefaultDragAdorner="False"
                              dd:DragDrop.UseVisualSourceItemSizeForDragAdorner="False"
                              dd:DragDrop.IsDragSource="True"
                              dd:DragDrop.IsDropTarget="True"
                              dd:DragDrop.DropHandler="{Binding}"
                              dd:DragDrop.DropScrollingMode="VerticalOnly"
                              Loaded="Tree_Loaded"
                              RequestBringIntoView="Tree_RequestBringIntoView" />
                </Grid>
            </Border>

            <Border Grid.Column="2" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
                <Grid Margin="8" DataContext="{Binding SelectedTemplateItem}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Eigenschaften" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />

                    <TextBlock Grid.Row="1" Text="Name" FontSize="12" Foreground="#555555" />
                    <TextBox Grid.Row="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />

                    <StackPanel Grid.Row="3" Visibility="{Binding IsTemplate, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="artikel" FontSize="12" Foreground="#555555" />
                        <TextBox Text="{Binding Article, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                        <TextBlock Text="normblatt" FontSize="12" Foreground="#555555" />
                        <TextBox Text="{Binding SheetName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                        <TextBlock Text="seitentemplate" FontSize="12" Foreground="#555555" />
                        <TextBox Text="{Binding PageTemplateName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                        <TextBlock Text="spalten-bedarf (px)" FontSize="12" Foreground="#555555" />
                        <TextBox Text="{Binding ColumnNeed, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                        <TextBlock Text="spalten-abstand (px)" FontSize="12" Foreground="#555555" />
                        <TextBox Text="{Binding ColumnSpacing, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                        <TextBlock Text="priorität" FontSize="12" Foreground="#555555" />
                        <TextBox Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                        <CheckBox Content="single page" IsChecked="{Binding SinglePage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Visibility="{Binding IsPageTemplate, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="priorität" FontSize="12" Foreground="#555555" />
                        <TextBox Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
                    </StackPanel>

                    <Grid Grid.Row="4"
                          Margin="0,14,0,0"
                          Visibility="{Binding HasXmlTemplate, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="xml-template"
                                   FontSize="12"
                                   Foreground="#555555"
                                   Margin="0,0,0,4" />

                        <TextBox Grid.Row="1"
                                 Text="{Binding XmlTemplate, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="90"
                                 VerticalAlignment="Stretch" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="3" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Margin="8,0,0,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Ausgabe" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Generieren" Padding="10,4" Click="GenerateOutput_Click" />
                    </Grid>

                    <TextBox x:Name="OutputXml"
                             Grid.Row="1"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
